# ─── Public (safe to expose to the browser; inlined at build time) ───────────────────────────
# Set after an approved Base Sepolia deployment (see DEPLOYMENT.md). Leave empty until then.
NEXT_PUBLIC_RILVA_ESCROW_ADDRESS=
NEXT_PUBLIC_RILVA_DEPLOY_BLOCK=

# ─── Hardhat (local only; NEVER prefix these with NEXT_PUBLIC_) ───────────────────────────────
# Optional: defaults to the public endpoint https://sepolia.base.org (rate-limited).
BASE_SEPOLIA_RPC_URL=

# Preferred: store secrets in the encrypted Hardhat keystore instead of this file:
#   pnpm hardhat keystore set BASE_SEPOLIA_PRIVATE_KEY
#   pnpm hardhat keystore set ETHERSCAN_API_KEY
# If you must use environment variables, export them in your shell for the one command you run.
# Hardhat 3 does not load .env files automatically, and .env* (except this file) is git-ignored.
# BASE_SEPOLIA_PRIVATE_KEY=0x<testnet-only deployer key — never a key that holds real funds>
# ETHERSCAN_API_KEY=<Etherscan v2 key, optional — Blockscout verification needs none>
