{
  "name": "rilva",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "climate:snapshot": "tsx scripts/climate/snapshot.ts",
    "climate:evidence": "tsx scripts/climate/evidence.ts",
    "climate:verify": "tsx scripts/climate/verify.ts",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test nodejs",
    "contracts:gas": "hardhat test nodejs --gas-stats",
    "contracts:coverage": "hardhat test nodejs --coverage",
    "contracts:abi": "tsx scripts/contracts/export-abi.ts",
    "contracts:deploy:local": "hardhat ignition deploy ignition/modules/RilvaEscrow.ts",
    "chain:node": "hardhat node",
    "chain:deploy:local": "hardhat ignition deploy ignition/modules/RilvaEscrow.ts --network localhost",
    "chain:seed:local": "tsx scripts/contracts/seed-local.ts",
    "chain:preflight:local": "hardhat run scripts/contracts/preflight.ts --network localhost",
    "chain:smoke:local": "tsx scripts/contracts/smoke.ts local",
    "contracts:preflight:base-sepolia": "hardhat run scripts/contracts/preflight.ts --network baseSepolia",
    "contracts:deploy:base-sepolia": "hardhat ignition deploy ignition/modules/RilvaEscrow.ts --network baseSepolia",
    "contracts:smoke:base-sepolia": "tsx scripts/contracts/smoke.ts base-sepolia",
    "contracts:verify:base-sepolia": "hardhat ignition verify chain-84532"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.4",
    "clsx": "2.1.1",
    "geist": "1.8.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "viem": "2.57.7",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "3.1.9",
    "@nomicfoundation/hardhat-ignition-viem": "3.1.6",
    "@nomicfoundation/hardhat-keystore": "3.1.2",
    "@nomicfoundation/hardhat-network-helpers": "3.0.12",
    "@nomicfoundation/hardhat-node-test-runner": "3.1.1",
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@nomicfoundation/hardhat-verify": "3.1.3",
    "@nomicfoundation/hardhat-viem": "3.0.10",
    "@nomicfoundation/hardhat-viem-assertions": "3.1.4",
    "@nomicfoundation/ignition-core": "3.1.8",
    "@openzeppelin/contracts": "5.6.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.2",
    "hardhat": "3.19.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
